import { useCallback, useEffect, useState } from "react";
import { Link } from "react-router-dom";
import {
    getNotifications,
    markNotificationRead,
    markAllNotificationsRead,
    type Notification
} from "../services/notificationService";

export default function Notifications() {
    const [notifications, setNotifications] = useState<Notification[]>([]);
    const [loading, setLoading] = useState(true);
    const [saving, setSaving] = useState(false);
    const [error, setError] = useState("");

    const loadNotifications = useCallback(async () => {
        setLoading(true);
        setError("");

        try {
            const data = await getNotifications();
            setNotifications(data);
        } catch (err: any) {
            setError(err.response?.data?.message || "Unable to load notifications.");
        } finally {
            setLoading(false);
        }
    }, []);

    useEffect(() => {
        loadNotifications();
    }, [loadNotifications]);

    const unreadCount = notifications.filter(item => !item.read).length;

    async function handleMarkRead(id: number) {
        setSaving(true);
        setError("");

        try {
            await markNotificationRead(id);
            setNotifications(current =>
                current.map(item =>
                    item.id === id ? { ...item, read: true } : item
                )
            );
        } catch (err: any) {
            setError(err.response?.data?.message || "Unable to update notification.");
        } finally {
            setSaving(false);
        }
    }

    async function handleMarkAllRead() {
        setSaving(true);
        setError("");

        try {
            await markAllNotificationsRead();
            setNotifications(current =>
                current.map(item => ({ ...item, read: true }))
            );
        } catch (err: any) {
            setError(err.response?.data?.message || "Unable to update notifications.");
        } finally {
            setSaving(false);
        }
    }

    function formatDate(value: string) {
        const date = new Date(value);
        return Number.isNaN(date.getTime())
            ? value
            : date.toLocaleString();
    }

    return (
        <div className="min-h-screen bg-slate-950 text-slate-100 p-4 md:p-8">
            <div className="max-w-5xl mx-auto space-y-6">
                <header className="flex flex-wrap justify-between items-center gap-4">
                    <div>
                        <p className="text-sm text-blue-400 font-medium">UPDATES</p>
                        <h1 className="text-3xl font-bold mt-1">Notifications</h1>
                        <p className="text-slate-400 mt-2">
                            Stay updated about leave requests and account activity.
                        </p>
                    </div>

                    <Link to="/"
                        className="px-4 py-2 rounded-lg bg-slate-800 hover:bg-slate-700">
                        Dashboard
                    </Link>
                </header>

                <section className="rounded-xl border border-slate-800 bg-slate-900 p-5">
                    <div className="flex flex-wrap justify-between items-center gap-3 mb-5">
                        <div>
                            <h2 className="text-xl font-semibold">All Notifications</h2>
                            <p className="text-sm text-slate-400 mt-1">
                                {unreadCount} unread of {notifications.length} notifications
                            </p>
                        </div>

                        <button
                            onClick={handleMarkAllRead}
                            disabled={saving || unreadCount === 0}
                            className="px-4 py-2 rounded-lg bg-blue-600 hover:bg-blue-500 disabled:opacity-40">
                            Mark All as Read
                        </button>
                    </div>

                    {error && (
                        <div className="mb-4 rounded-lg bg-red-500/10 border border-red-500/30 p-3 text-red-300">
                            {error}
                        </div>
                    )}

                    {loading ? (
                        <p className="text-center text-slate-400 py-12">
                            Loading notifications...
                        </p>
                    ) : notifications.length === 0 ? (
                        <div className="text-center py-12">
                            <p className="text-lg font-medium">No notifications yet</p>
                            <p className="text-slate-500 text-sm mt-2">
                                New updates will appear here.
                            </p>
                        </div>
                    ) : (
                        <div className="space-y-3">
                            {notifications.map(item => (
                                <article key={item.id}
                                    className={`rounded-lg border p-4 ${
                                        item.read
                                            ? "border-slate-800 bg-slate-950/50"
                                            : "border-blue-500/30 bg-blue-500/5"
                                    }`}>
                                    <div className="flex flex-wrap justify-between gap-3">
                                        <div className="flex-1 min-w-0">
                                            <div className="flex flex-wrap items-center gap-2">
                                                <h3 className="font-semibold">{item.title}</h3>
                                                {!item.read && (
                                                    <span className="rounded-full bg-blue-500/15 text-blue-300 px-2 py-1 text-xs">
                                                        Unread
                                                    </span>
                                                )}
                                                <span className="rounded-full bg-slate-800 text-slate-300 px-2 py-1 text-xs">
                                                    {item.type}
                                                </span>
                                            </div>

                                            <p className="text-slate-300 mt-2 text-sm whitespace-pre-wrap">
                                                {item.message}
                                            </p>

                                            <p className="text-xs text-slate-500 mt-3">
                                                {formatDate(item.createdAt)}
                                            </p>
                                        </div>

                                        {!item.read && (
                                            <button
                                                onClick={() => handleMarkRead(item.id)}
                                                disabled={saving}
                                                className="text-sm text-blue-400 hover:text-blue-300 disabled:opacity-50">
                                                Mark as Read
                                            </button>
                                        )}
                                    </div>
                                </article>
                            ))}
                        </div>
                    )}

                    {!loading && notifications.length > 0 && (
                        <button
                            onClick={loadNotifications}
                            className="mt-5 text-sm text-blue-400 hover:text-blue-300">
                            Refresh notifications
                        </button>
                    )}
                </section>
            </div>
        </div>
    );
}

